{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Croc UI",
  "version": "1.0.0",
  "identifier": "com.crocui.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Croc UI - 安全文件传输",
        "width": 520,
        "height": 720,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "croc",
          "cmd": "croc",
          "args": true
        }
      ]
    }
  }
}
